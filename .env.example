# Example environment file for local development
# Copy this to .env.local and fill in your values

# Formstack API Configuration
FORMSTACK_API_URL=https://www.formstack.com/api/v2
FORMSTACK_ACCESS_TOKEN=your_access_token_here
FORMSTACK_FORM_ID=your_form_id_here

# Optional: For production deployment
NEXT_PUBLIC_API_BASE_URL=https://api.clubserve.com
